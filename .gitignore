# =========================================================================
# Fichier .gitignore recommandé pour un projet Fullstack (Java Spring & React/Vite)
# =========================================================================

# --- Spécifique à la demande (Claude & TP) ---
.claude/
TP_DEVOPS_BanqueMSSol.md

# --- FRONT-END (React + Vite) ---
**/node_modules/
**/dist/
**/dist-ssr/
*.local

# Fichiers d'environnement Vite (Contiennent des clés API / secrets locaux)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs de paquets (npm, yarn, pnpm)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Outils de linting / cache du front
.eslintcache
.stylelintcache
*.tsbuildinfo

# --- BACK-END (Java / Spring) ---
# Compilateurs et Sorties de Construction
**/target/
**/bin/
*.class
*.war
*.ear
*.jar
*.nar
*.rar

# Outils de Build (Maven & Gradle)
# Maven
.mvn/
mvnw
mvnw.cmd
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
pom.xml.note
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/wrapper/maven-wrapper.properties

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
gradlew
gradlew.cmd

# --- Environnements de Développement (IDEs) ---
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.metadata/
.classpath
.project
.settings/
*.launch
*.factorypath

# VS Code
.vscode/

# --- Config & Sécurité (Fichiers sensibles / secrets Back) ---
**/src/main/resources/application-local.properties
**/src/main/resources/application-local.yml
**/src/main/resources/application-local.yaml
*.jks
*.keystore
*.p12
*.pfx

# --- Conteneurs, DevOps, Logs & Système ---
.docker/
.kube/
**/data/
*.log
**/logs/
**/tmp/
**/temp/
.DS_Store
.DS_Store?
._*
Thumbs.db