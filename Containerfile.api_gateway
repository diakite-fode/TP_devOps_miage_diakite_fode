# ============================================================================
#  Containerfile.api_gateway — service de référence : Banque-APIGateway
#  Construit avec Buildah (rootless). Multi-stage pour une image finale légère.
#
#  Build (image canonique, base Ubuntu jammy) :
#    buildah bud -t banquemssol-apigateway:local \
#      --build-arg APP_PORT=10000 \
#      -f Containerfile.api_gateway Banque-APIGateway
#
#  Variante Alpine (plus petite MAIS introduit des CVE OS gnutls -> non retenue,
#  voir docs/dive-analysis.md) :
#    buildah bud -t banquemssol-apigateway:alpine \
#      --build-arg BASE_IMAGE=eclipse-temurin:11-jre-alpine \
#      -f Containerfile.api_gateway Banque-APIGateway
#
#  Généralisation aux autres modules : changer le contexte (dossier du module)
#  et APP_PORT. Le JAR est toujours dans <module>/target/*.jar.
# ============================================================================

# Image de base, paramétrable. jammy = base par défaut (0 CVE OS). Alpine plus
# petite mais introduit des CVE OS -> réservée à la démonstration A.4.
# Déclaré avant le 1er FROM pour être utilisable dans les deux étapes.
ARG BASE_IMAGE=eclipse-temurin:11-jre-jammy

# ---------------------------------------------------------------------------
# STAGE 1 — "builder" : on éclate le fat-jar Spring Boot en couches (layertools)
# pour séparer les dépendances (stables) du code applicatif (volatil).
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS builder
WORKDIR /build

ARG JAR_FILE=target/*.jar
COPY ${JAR_FILE} application.jar

RUN java -Djarmode=layertools -jar application.jar extract

# ---------------------------------------------------------------------------
# STAGE 2 — image finale : base légère, SANS outils de build, exécutée non-root.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS runtime

ARG APP_PORT=10000
WORKDIR /app

# Sécurité : on tourne sous un UID NON-root (1000). Un UID numérique est
# portable sur toutes les bases (pas besoin de useradd/adduser) et évite de
# modifier /etc/passwd (donc moins de couches et moins de gaspillage).
USER 1000:1000

# Couches extraites, du moins au plus volatil (meilleur cache au rebuild).
COPY --from=builder --chown=1000:1000 /build/dependencies/          ./
COPY --from=builder --chown=1000:1000 /build/spring-boot-loader/    ./
COPY --from=builder --chown=1000:1000 /build/snapshot-dependencies/ ./
COPY --from=builder --chown=1000:1000 /build/application/           ./

EXPOSE ${APP_PORT}

ENTRYPOINT ["java", "org.springframework.boot.loader.JarLauncher"]
